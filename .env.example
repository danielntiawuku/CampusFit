# CampusFit — Supabase configuration
# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard → Project Settings → API).
#
#   cp .env.example .env
#
# The app reads these at build time. Never commit the real `.env`.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: Mapbox public token for the live campus map (/map).
# Without it the map screen shows a placeholder instead of the map.
VITE_MAPBOX_TOKEN=pk.your-public-mapbox-token

# Optional: used only by `supabase db reset` / seed scripts, never shipped to the browser.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: Supabase CLI / Management API token (server-side only, never shipped).
# SUPABASE_ACCESS_TOKEN=sbp_...
